# Schema Flow Environment Variables Configuration
# Choose one of the 3 deployment modes below:

# -------------------------------------------------------------
# Mode 1: Local Machine (Development using local SQLite file)
# -------------------------------------------------------------
DATABASE_URL="file:./data/schema-flow.db"

# -------------------------------------------------------------
# Mode 2: Vercel / Serverless Deployment (Turso Cloud Edge Database)
# -------------------------------------------------------------
# DATABASE_URL="libsql://your-db-name-org.turso.io"
# TURSO_AUTH_TOKEN="ey..."

# -------------------------------------------------------------
# Mode 3: Docker Container (Self-hosted using persistent file volume)
# -------------------------------------------------------------
# DATABASE_URL="file:/app/data/schema-flow.db"

# -------------------------------------------------------------
# Clerk Authentication Configuration
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
