# Schema Flow Environment Configuration

# SQLite Database File Path (Default: ./data/schema-flow.db)
DATABASE_PATH=./data/schema-flow.db

# Alternative environment variable aliases
# DATABASE_FILE=./data/schema-flow.db
# DATABASE_URL=./data/schema-flow.db

# Server Host & Port
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
